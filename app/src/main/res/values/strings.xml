    <!-- Daily fiber nudge (supportive tone; never shame or streaks) -->
    <string name="nudge_fiber_gap">You\'re at %1$dg of fiber today. A serving of %2$s (%3$s) adds about %4$dg — small and doable.</string>
    <!-- Softer variant for people on a GLP-1: no target framing, appetite-aware -->
    <string name="nudge_fiber_gap_gentle">You\'re at %1$dg of fiber today. No pressure at all — if it feels right, a little %2$s (%3$s) adds about %4$dg.</string>
    <string name="nudge_on_track">You\'re at %1$dg of fiber today, right around your %2$dg goal. That\'s enough.</string>
    <!-- Today's one swap: a zero-input daily idea, never a nudge to log; always leaves an out -->
    <string name="today_swap_header">One idea for today</string>
    <string name="today_swap_body">%1$s (%2$s) is an easy ~%3$dg of fiber — or not, today can just be today.</string>
    <!-- Softer variant for people on a GLP-1: no number to hit, appetite-aware -->
    <string name="today_swap_body_gentle">%1$s (%2$s) adds a little fiber, if it feels right — no number to hit.</string>
    <!-- The "Enough" reset-day moment: warm, zero catch-up math, an easy out -->

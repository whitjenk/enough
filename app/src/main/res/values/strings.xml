    <!-- Settings -->
    <string name="settings_hc_sync_title">Sync with Health Connect</string>
    <string name="settings_hc_sync_desc">Read steps, sleep, and weight from Health Connect. Turn off to log everything by hand.</string>
    <string name="settings_calibration_title">Fiber estimate style</string>
    <string name="settings_calibration_desc">When a food\'s fiber isn\'t exact, choose how estimates lean. It only shifts your daily total a little — there\'s no wrong pick.</string>
    <string name="settings_calibration_low">Lean lower</string>
    <string name="settings_calibration_balanced">Balanced</string>
    <string name="settings_calibration_high">Lean higher</string>

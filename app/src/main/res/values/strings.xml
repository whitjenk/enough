    <string name="settings_hide_numbers_desc">Show trends instead of exact weight and fiber numbers — here, and on anything you share.</string>
    <!-- GLP-1 stance: tunes fiber tone (gentle / satiety-bridge). Tone only, not medical advice. -->
    <string name="settings_glp1_title">GLP-1 medication</string>
    <string name="settings_glp1_desc">On a GLP-1, or coming off one? Fiber tips stay gentle and appetite-aware. This only tunes tone — it isn\'t medical advice.</string>
    <string name="settings_glp1_not">Not on one</string>
    <string name="settings_glp1_on">On a GLP-1</string>
    <string name="settings_glp1_coming_off">Coming off one</string>
    <string name="settings_glp1_prefer_not">Prefer not to say</string>
    <!-- Help improve Enough: user-initiated, aggregate-only, nothing sent on its own -->
    <string name="settings_feedback_title">Help improve Enough</string>
    <string name="settings_feedback_desc">Nothing is ever sent on its own. You can look at an anonymous summary of your use — just counts, nothing that identifies you — and choose to share it if you want.</string>
    <string name="settings_feedback_prepare">See the summary</string>
    <string name="settings_feedback_share">Share this summary</string>
    <string name="feedback_yes">yes</string>
    <string name="feedback_no">no</string>
    <string name="feedback_share_text">Enough — anonymous summary (nothing here identifies me).\nDays I logged a meal: %1$d\nMeals logged: %2$d\nDays I reached my fiber goal: %3$d of %1$d\nFiber goal: %4$dg/day\nWeight goal set: %5$s\nUsed the daily check-in: %6$s\nShared a card: %7$s</string>
    <string name="settings_support_title">Going through a rough patch?</string>
    <string name="settings_support_desc">Progress isn\'t a straight line, and missing a day doesn\'t undo what you\'ve built. One small thing, whenever you\'re ready, is enough. If things feel heavy — with your health or otherwise — it\'s okay to lean on your doctor or someone you trust.</string>
    <string name="settings_privacy_title">Privacy</string>
    <string name="settings_privacy_desc">Everything stays on your phone — no account, no server, nothing sold.</string>
    <string name="settings_privacy_policy_link">Read the full privacy policy</string>
    <string name="privacy_policy_url" translatable="false">https://whitjenk.github.io/enough/</string>
    <string name="settings_delete_title">Delete my data</string>
    <string name="settings_delete_desc">Permanently remove everything you\'ve logged from this phone.</string>
    <string name="settings_delete_button">Delete my data</string>

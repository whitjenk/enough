    <!-- Onboarding: welcome -->
    <string name="onboarding_welcome_title">Welcome to Enough</string>
    <string name="onboarding_welcome_body">One small, doable thing a day — starting with fiber. Everything stays on your phone. No account, nothing sold.</string>
    <string name="onboarding_welcome_disclaimer">Enough isn\'t medical advice or a diagnosis. It\'s a supportive companion — talk with your doctor about your health.</string>
    <string name="onboarding_get_started">Get started</string>

    <!-- Onboarding: risk test -->
    <string name="onboarding_risk_title">A quick risk check</string>
    <string name="onboarding_risk_subtitle">Seven questions from the CDC/ADA Prediabetes Risk Test. No blood test, and nothing leaves your phone.</string>
    <string name="risk_q_age">How old are you?</string>
    <string name="age_under_40">Under 40</string>
    <string name="age_40_49">40 to 49</string>
    <string name="age_50_59">50 to 59</string>
    <string name="age_60_plus">60 or older</string>
    <string name="risk_q_sex">What is your sex?</string>
    <string name="risk_q_sex_help">The risk test scores this as a biological risk factor.</string>
    <string name="sex_male">Male</string>
    <string name="sex_female">Female</string>
    <string name="risk_q_gestational">Were you ever diagnosed with diabetes during pregnancy (gestational diabetes)?</string>
    <string name="risk_q_family">Do you have a parent or sibling with diabetes?</string>
    <string name="risk_q_bp">Have you ever been told you have high blood pressure?</string>
    <string name="risk_q_active">Are you physically active?</string>
    <string name="risk_q_height">Height</string>
    <string name="risk_q_weight">Weight</string>
    <string name="risk_weight_hint">Pounds</string>
    <string name="risk_asian_note">If you\'re of Asian descent, diabetes risk can begin at a lower weight — worth keeping in mind.</string>
    <string name="onboarding_see_result">See my result</string>
    <string name="unit_feet">ft</string>
    <string name="unit_inches">in</string>
    <string name="height_value">%1$d ft %2$d in</string>

    <!-- Onboarding: risk result -->
    <string name="risk_result_title">Your result</string>
    <string name="risk_result_score">%1$d out of %2$d</string>
    <string name="risk_result_higher">This points to a higher chance of prediabetes. That\'s useful to know — and there\'s a lot you can do, starting small.</string>
    <string name="risk_result_lower">Your score is on the lower side today. Building fiber and movement habits helps keep it that way.</string>
    <string name="risk_result_disclaimer">This is a screening estimate, not a diagnosis. Your doctor can test to know for sure.</string>
    <string name="onboarding_set_goals">Set my goals</string>

    <!-- Onboarding: goals -->
    <string name="goals_title">Your goals</string>
    <string name="goals_weight_header">Weight</string>
    <string name="goals_weight_desc">A 5 to 7%% shift is enough to matter. From about %1$s, that\'s around %2$s.</string>
    <string name="goals_weight_percent_label">Aim for %1$d%% less</string>
    <string name="weight_pounds">%1$d lb</string>
    <string name="goals_activity_header">Weekly movement</string>
    <string name="goals_activity_desc">Pick whatever fits your body and your life.</string>

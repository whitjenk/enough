    <!-- Onboarding: Health Connect -->
    <string name="hc_title">Connect Health Connect</string>
    <string name="hc_desc">If you\'d like, Enough can read your steps, sleep, and weight from Health Connect so you don\'t have to log them by hand. It only reads — nothing is written or shared.</string>

    <string name="diet_nut_allergy">Nut allergy</string>
    <string name="extras_diet_other_label">Anything else (optional)</string>
    <string name="extras_why_header">What\'s making you want to do this?</string>
    <string name="extras_why_desc">Just for you — nobody else sees it.</string>
    <string name="extras_why_hint">Optional</string>
    <string name="extras_glp1_header">Medication</string>
    <string name="extras_glp1_question">Are you currently taking a GLP-1 medication (Ozempic, Wegovy, Zepbound, or similar)?</string>

    <!-- Onboarding: Health Connect -->
    <string name="hc_title">Connect Health Connect</string>
    <string name="hc_desc">If you\'d like, Enough can read your steps, sleep, and weight from Health Connect so you don\'t have to log them by hand. It only reads — nothing is written or shared.</string>
    <string name="hc_connect">Connect</string>
    <string name="hc_connected">Connected</string>
    <string name="hc_unavailable">Health Connect isn\'t available on this device. That\'s fine — you can log everything by hand.</string>
    <string name="hc_update_required">Health Connect needs an update before it can connect. You can do that anytime and log by hand until then.</string>
    <string name="onboarding_finish">Finish</string>


<!--
   "Progress" — three bars of deliberately uneven height, mirroring the fiber
   trend chart on that screen. Uneven rather than ascending on purpose: a
   rising staircase would imply the week is supposed to climb, which is the
   scoring/streak framing this app rejects. A real week goes up and down.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M6,17 L6,13" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,17 L12,7" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M18,17 L18,11" />
</vector>

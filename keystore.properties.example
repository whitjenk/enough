# Release signing config for the Enough app.
#
# 1. Copy this file to `keystore.properties` (which is git-ignored — never commit it).
# 2. Generate an upload keystore if you don't have one yet:
#
#      keytool -genkeypair -v \
#        -keystore upload-keystore.jks \
#        -alias enough-upload \
#        -keyalg RSA -keysize 2048 -validity 10000
#
#    Store `upload-keystore.jks` somewhere safe and OUTSIDE the repo (or at the repo
#    root, where *.jks is git-ignored). Losing it means you can't push updates unless
#    you enrolled in Play App Signing and can request an upload-key reset.
# 3. Fill in the values below. `storeFile` is resolved relative to the repo root.
#
# With this file present, `./gradlew bundleRelease` produces a signed AAB ready for
# the Play Console. Without it, the release build is simply left unsigned.

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=enough-upload
keyPassword=CHANGE_ME
